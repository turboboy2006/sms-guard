<?xml version="1.0" encoding="utf-8"?>
<!--
  Palette. #2563EB is the ONLY primary; green / red / purple / teal appear only
  as category or status identity. No gradients anywhere.
-->
<resources>
    <!-- Primary -->
    <color name="blue_50">#EFF6FF</color>
    <color name="blue_100">#DBEAFE</color>
    <color name="blue_300">#93B4F5</color>
    <color name="blue_500">#2563EB</color>
    <color name="blue_600">#1D4ED8</color>
    <color name="blue_700">#1E40AF</color>
    <color name="blue_900">#172554</color>

    <color name="colorPrimary">@color/blue_500</color>
    <color name="colorPrimaryDark">@color/blue_700</color>
    <color name="colorAccent">@color/blue_600</color>

    <!-- Surfaces and text -->
    <color name="screen_bg">#F8FAFC</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="surface_sunken">#F1F5F9</color>
    <color name="text_primary">#172033</color>
    <color name="text_secondary">#475467</color>
    <color name="text_muted">#667085</color>
    <color name="divider">#E7ECF3</color>
    <color name="border_soft">#D7DDE8</color>
    <color name="skeleton">#E7ECF3</color>

    <!-- Unread row and its marker -->
    <color name="unread_bg">#EFF6FF</color>
    <color name="unread_dot">@color/blue_500</color>

    <!-- Filter chips -->
    <color name="chip_inactive_bg">#F1F5F9</color>

    <!-- Category badges: neutral by default, red only for suspicious -->
    <color name="badge_bg">#F1F5F9</color>
    <color name="badge_text">#475467</color>
    <color name="badge_danger_bg">#FEE2E2</color>
    <color name="badge_danger_text">#B91C1C</color>

    <!-- Semantic -->
    <color name="danger">#B91C1C</color>
    <color name="danger_deep">#991B1B</color>
    <color name="danger_soft">#FEE2E2</color>
    <color name="warning">#EA580C</color>
    <color name="warning_soft">#FFEDD5</color>
    <color name="success">#15803D</color>

    <!-- Chat bubbles -->
    <color name="bubble_incoming">#F1F5F9</color>
    <color name="bubble_outgoing">@color/blue_100</color>
    <color name="bubble_in_text">@color/text_primary</color>
    <color name="bubble_out_text">@color/blue_900</color>

    <color name="ic_launcher_background">@color/blue_600</color>

    <!-- Category identity colours, as specified -->
    <color name="cat_personal_c">#15803D</color>
    <color name="cat_banking_c">#1D4ED8</color>
    <color name="cat_otp_c">#0F766E</color>
    <color name="cat_notification_c">#7C3AED</color>
    <color name="cat_promotion_c">#EA580C</color>
    <color name="cat_suspicious_c">#E11D48</color>
    <color name="cat_spam_c">#B91C1C</color>
    <color name="cat_other_c">#667085</color>
    <color name="cat_trash_c">#475467</color>
</resources>
