<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Material 3. DayNight gives light/dark automatically; the night palette
      lives in values-night/colors.xml and is picked up through these roles.

      Dynamic colour (Material You) is deliberately NOT enabled: it would replace
      the requested blue with a wallpaper-derived hue.
    -->
    <style name="Theme.SmsGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/blue_100</item>
        <item name="colorOnPrimaryContainer">@color/blue_900</item>

        <item name="colorSecondary">@color/blue_600</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/screen_bg</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/card_bg</item>

        <!-- One shape scale for cards, buttons, inputs and dialogs -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.SmsGuard.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.SmsGuard.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.SmsGuard.Large</item>

        <!-- Hairline elevation only: no heavy legacy shadows -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/blue_500</item>
    </style>

    <style name="Shape.SmsGuard.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="Shape.SmsGuard.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="Shape.SmsGuard.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- Flat outlined card: border instead of shadow -->
    <style name="Widget.SmsGuard.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Typography: 4 sizes, 2 weights -->
    <style name="TextAppearance.SmsGuard.Display" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SmsGuard.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.SmsGuard.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.SmsGuard.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Section header used on the settings screen -->
    <style name="TextAppearance.SmsGuard.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
