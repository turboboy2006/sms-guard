<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens. Every spacing value is a multiple of 4dp, so the whole app sits
  on one 8pt grid (8 / 16 / 24 / 32) with 4dp used only for tight pairs.
  Add new dimensions here rather than hard-coding values in layouts.
-->
<resources>
    <!-- 8pt grid -->
    <dimen name="space_2">2dp</dimen>
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>

    <!-- Unified corner radius, matching the reference (12 dominant) -->
    <dimen name="radius_sm">10dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- Minimum accessible touch target -->
    <dimen name="touch_target">48dp</dimen>

    <!-- Content -->
    <dimen name="gutter">16dp</dimen>
    <dimen name="avatar">48dp</dimen>
    <!-- A conversation row reads as a summary, not as a message: 84dp fits a
         name, two lines of preview and a category pill, and 96dp is the
         ceiling. Measured against the reference, which is tighter than it
         first looks. -->
    <dimen name="row_min_height">84dp</dimen>
    <dimen name="row_max_height">96dp</dimen>
    <dimen name="appbar_height">64dp</dimen>
    <dimen name="chip_height">46dp</dimen>
    <dimen name="chip_padding_h">18dp</dimen>
    <dimen name="badge_height">24dp</dimen>
    <dimen name="bottom_nav_height">72dp</dimen>
    <dimen name="time_column">84dp</dimen>
    <dimen name="color_stripe_width">4dp</dimen>
    <dimen name="swatch">40dp</dimen>

    <!-- Typography scale -->
    <dimen name="text_display">22sp</dimen>
    <dimen name="text_title">17sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_label">13sp</dimen>
    <dimen name="text_meta">13sp</dimen>
</resources>
