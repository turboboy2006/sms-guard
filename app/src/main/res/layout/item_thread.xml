<?xml version="1.0" encoding="utf-8"?>
<!--
  One inbox row, laid out to match the reference exactly.

  Reading order, right to left, as the target draws it:

      [ avatar ]  [ name ............ ] [ time ]
                  [ preview ................... ]
                  [ badge ]

  The avatar is pinned to the physical right by putting it first inside a block
  whose layout direction is right-to-left, so it leads for a Persian reader
  instead of being mirrored to the far side. The time keeps its own fixed
  column, so the names of every row start on the same optical line whatever the
  time text is.

  Everything that varies with the chosen row style — background, avatar size,
  padding, the accent bar — is written by ThreadAdapter on bind.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/accentBar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layoutDirection="rtl"
            android:gravity="top"
            android:minHeight="@dimen/row_min_height"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <FrameLayout
                android:id="@+id/avatar"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/avatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/avatarLetter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iconWarning"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/cat_suspicious"
                        android:src="@drawable/ic_tab_suspicious"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <!-- Its own column, so every row's name ends on the same
                         line no matter how long the time text is. -->
                    <TextView
                        android:id="@+id/textDate"
                        android:layout_width="@dimen/time_column"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:textAlignment="textStart"
                        android:textColor="@color/text_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Two lines maximum: a conversation preview is a summary, and
                     the rest of the message belongs in the conversation. -->
                <TextView
                    android:id="@+id/textSnippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="13.5sp" />

                <!-- On its own line, as in the reference: a category pill that
                     shares a line with the preview would steal its width. -->
                <TextView
                    android:id="@+id/textCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="76dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider" />
    </FrameLayout>

</LinearLayout>
