<?xml version="1.0" encoding="utf-8"?>
<!--
  Appearance. Every control here writes through to the live preview above it and
  to the inbox behind this screen, so nothing has to be saved or guessed: what
  the preview shows is exactly what the list will look like.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/appbar_height"
        android:background="@color/card_bg"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/appearance_section"
        app:titleTextAppearance="@style/TextAppearance.SmsGuard.Title"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/gutter">

            <!-- ========================= Preview ========================= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_8">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/space_16"
                        android:text="@string/preview_title"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <ir.inod.smsguard.AppearancePreviewView
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- A short list of ready-made looks makes appearance changes
                 approachable. The detailed controls below remain available
                 for people who want to tune a preset. -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance_presets"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/appearance_presets_hint"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Hint" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/presetGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        app:selectionRequired="false"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPresetModern"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/preset_modern" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPresetCompact"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/preset_compact" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPresetCards"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_target"
                            android:text="@string/preset_cards" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/space_16"
                        android:paddingEnd="@dimen/space_16"
                        android:text="@string/color_palettes"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_12"
                        android:scrollbars="none">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/paletteGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteOcean" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_ocean" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteEmerald" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_emerald" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteViolet" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_violet" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteRose" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_rose" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteAmber" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_amber" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteIndigo" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_indigo" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteCoral" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_coral" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteLime" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_lime" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteSky" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_sky" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/buttonPaletteSunset" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/palette_sunset" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================== Text =========================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBackground"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/background_style" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/glass_opacity"
                android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSurfaceOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="85"
                android:valueTo="100" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/text_section"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/list_font"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <Spinner
                        android:id="@+id/spinnerListFont"
                        style="@style/Widget.SmsGuard.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/message_font"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <Spinner
                        android:id="@+id/spinnerMessageFont"
                        style="@style/Widget.SmsGuard.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====================== Row background ===================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/row_style_section"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <Spinner
                        android:id="@+id/spinnerRowStyle"
                        style="@style/Widget.SmsGuard.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8" />

                    <TextView
                        android:id="@+id/textRowStyleHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/message_style"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <Spinner
                        android:id="@+id/spinnerMessageStyle"
                        style="@style/Widget.SmsGuard.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================== Spacing ========================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/spacing_section"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/row_padding"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRowPadding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:valueFrom="4"
                        android:valueTo="28" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/row_spacing"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRowSpacing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="0"
                        android:valueTo="20" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/row_inset"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRowInset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="0"
                        android:valueTo="16" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/list_padding"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderListPadding"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:valueFrom="0"
                        android:valueTo="40" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/message_spacing"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderMessageSpacing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="0"
                        android:valueTo="16" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bubble_radius"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBubbleRadius"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:valueFrom="0"
                        android:valueTo="24" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================== Switch ========================= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDividers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/show_dividers" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/show_chips" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonReset"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:minHeight="@dimen/touch_target"
                android:text="@string/reset_appearance" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
