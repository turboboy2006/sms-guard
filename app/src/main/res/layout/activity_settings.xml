<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings, grouped so the screen reads as four short decisions rather than one
  long form:

    1. how messages are analysed        (offline first, then the optional API)
    2. what the app looks like          (a link to its own screen)
    3. what the app is in                (language)
    4. what can be managed              (categories, brands, rules)

  Every group is a card with one heading, and no raw EditText is left on the
  screen: inputs are outlined fields with a hint, which is what made the
  previous version feel rough.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/card_bg"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
        app:title="@string/settings_title"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/gutter">

            <!-- ==================== Detection: offline =================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_detection"
                android:textAppearance="@style/TextAppearance.SmsGuard.Group" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/local_section"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/threshold_hint"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Hint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderThreshold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:stepSize="5"
                            android:valueFrom="10"
                            android:valueTo="95" />

                        <TextView
                            android:id="@+id/textThreshold"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Detection: AI ======================= -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_section"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/ai_enable" />

                    <TextView
                        android:id="@+id/textAiHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_hint_off"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Hint" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:hint="@string/ai_base">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editBase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textUri" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="@string/ai_key"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="@string/ai_model">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editModel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:hint="@string/ai_timeout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTimeout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonTest"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/test_connection" />

                    <TextView
                        android:id="@+id/textTestResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====================== Quiet hours ======================== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchQuiet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/quiet_enable" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/quiet_hint"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Hint" />

                    <LinearLayout
                        android:id="@+id/groupQuietHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textQuietWindow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_12"
                            android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/quiet_from"
                            android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                        <Spinner
                            android:id="@+id/spinnerQuietFrom"
                            style="@style/Widget.SmsGuard.Spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:text="@string/quiet_to"
                            android:textAppearance="@style/TextAppearance.SmsGuard.Label" />

                        <Spinner
                            android:id="@+id/spinnerQuietTo"
                            style="@style/Widget.SmsGuard.Spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================= Appearance ======================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/group_appearance"
                android:textAppearance="@style/TextAppearance.SmsGuard.Group" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <LinearLayout
                        android:id="@+id/rowAppearance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_12">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/space_8"
                            android:paddingBottom="@dimen/space_8">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/appearance_section"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:id="@+id/textAppearanceSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SmsGuard.Hint" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron"
                            app:tint="@color/text_muted" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:id="@+id/rowCache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_12"
                        android:paddingEnd="@dimen/space_12">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/space_8"
                            android:paddingBottom="@dimen/space_8">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/inbox_cache"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body" />

                            <TextView
                                android:id="@+id/textCacheSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SmsGuard.Hint" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========================= General ========================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/group_general"
                android:textAppearance="@style/TextAppearance.SmsGuard.Group" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/language"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <Spinner
                        android:id="@+id/spinnerLanguage"
                        style="@style/Widget.SmsGuard.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/trash_retention"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <Spinner
                        android:id="@+id/spinnerTrashRetention"
                        style="@style/Widget.SmsGuard.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/default_sending_sim"
                        android:textAppearance="@style/TextAppearance.SmsGuard.Section" />

                    <Spinner
                        android:id="@+id/spinnerDefaultSim"
                        style="@style/Widget.SmsGuard.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================== Management ======================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/group_manage"
                android:textAppearance="@style/TextAppearance.SmsGuard.Group" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmsGuard.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCategories"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/manage_categories" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonBrands"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/manage_brands" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRules"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/rules" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonScheduled"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/scheduled_messages" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonExportBackup"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/export_backup" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonImportBackup"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_target"
                        android:text="@string/import_backup" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:minHeight="@dimen/touch_target"
                android:text="@string/save" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
