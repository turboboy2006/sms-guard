<?xml version="1.0" encoding="utf-8"?>
<!-- Chip icons and labels share one tint, so a chip is never half blue. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A selected chip is the one saturated element in the filter strip.
         Its content must switch to white; blue-on-blue looked low-contrast
         and made the selected state harder to scan. -->
    <item android:color="@android:color/white" android:state_checked="true" />
    <item android:color="@color/chip_inactive_text" />
</selector>
