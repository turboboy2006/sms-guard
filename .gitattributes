# Keep line endings predictable. The CI runner is Linux and CRLF inside a
# workflow `run:` block makes bash fail with "$'\r': command not found".
* text=auto eol=lf

# Windows-only script types keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary-ish files must never be normalised.
*.apk binary
*.jar binary
*.png binary
*.jpg binary
*.webp binary
